# Handler API environment
# Copy to .env for local development

# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host.neon.tech/handler?sslmode=require

# JWT signing secret (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-secret

# Single-user credentials
HANDLER_USERNAME=lachlan
# Generate hash with: node -e "const b=require('bcryptjs');b.hash('yourpassword',12).then(console.log)"
HANDLER_PASSWORD_HASH=$2b$12$examplehashhere

# CORS: allow the web frontend
WEB_ORIGIN=http://localhost:3000

# API port (default 3001)
PORT=3001
